generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BusinessType {
  RETAIL
  GROCERY
  RESTAURANT_CAFE
  SALON
  BARBERSHOP
  GARAGE
  AUTO_SPARES
  LAUNDRY
  HARDWARE
  ELECTRONICS
  PRINTING
  GENERAL_SERVICES
  OTHER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AccountTokenType {
  EMAIL_ACTIVATION
  PASSWORD_RESET
}

enum ReconciliationStatus {
  SUBMITTED
  APPROVED
}

enum RefundStatus {
  COMPLETED
  VOIDED
}

enum RefundKind {
  REFUND
  RETURN
  EXCHANGE
}

enum RegisterShiftStatus {
  OPEN
  CLOSED
  APPROVED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

enum OperationalAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum SaleSource {
  ONLINE
  OFFLINE_SYNC
}

enum OfflineSyncStatus {
  PENDING
  SYNCED
  CONFLICT
  REJECTED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
  CUSTOM
}

enum BillingRecordStatus {
  DUE
  PAID
  VOID
  FAILED
  WAIVED
}

enum ProductType {
  STOCK_ITEM
  SERVICE
  NON_STOCK_ITEM
}

enum StockLocationType {
  DEFAULT
  WAREHOUSE
  STORE
  OTHER
}

enum StockMovementType {
  OPENING
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  SALE
  PURCHASE
}

enum PurchaseStatus {
  DRAFT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CustomerLedgerEntryType {
  CREDIT_SALE
  PAYMENT
  ADJUSTMENT
}

enum ExpenseStatus {
  RECORDED
  REVERSED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CommissionRuleType {
  PERCENTAGE
  FIXED
}

enum CommissionStatus {
  EARNED
  REVERSED
}

enum SaleStatus {
  DRAFT
  HELD
  COMPLETED
  CANCELLED
}

enum SalePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  QR
  OTHER
}

enum PaymentRecordStatus {
  RECORDED
  VOIDED
}

enum PaystackPaymentStatus {
  INITIALIZING
  REQUIRES_ACTION
  PAID
  COMPLETED
  FAILED
  PAID_REQUIRES_REVIEW
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum StockTransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum PilotStatus {
  PENDING_SETUP
  ONBOARDING
  READY_FOR_UAT
  PILOT_ACTIVE
  PAUSED
  GRADUATED
  EXITED
}

enum OnboardingStepStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum SupportIssueCategory {
  POS
  PAYMENT
  RECEIPT
  INVENTORY
  CUSTOMER
  PURCHASE
  REPORT
  OFFLINE_SYNC
  SUBSCRIPTION
  LOGIN_ACCESS
  APPOINTMENT
  OTHER
}

enum SupportIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportIssueStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FeedbackCategory {
  BUG
  USABILITY
  MISSING_CORE
  ENHANCEMENT
  OUT_OF_SCOPE
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  legalName          String?
  arabicName         String?
  businessType       BusinessType
  registrationNumber String?
  email              String?
  phone              String?
  currency           String             @default("QAR")
  timezone           String             @default("Asia/Qatar")
  logoUrl            String?
  welcomeHeadline    String?
  tagline            String?
  motto              String?
  welcomeMessage     String?
  brandPrimaryColor  String             @default("#172C2B")
  brandAccentColor   String             @default("#FFCF5C")
  idleTimeoutMinutes Int                @default(5)
  employeePrefix     String             @default("EMP")
  nextEmployeeNumber Int                @default(1)
  nextBranchNumber   Int                @default(1)
  status             OrganizationStatus @default(TRIAL)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  branches               Branch[]
  memberships            OrganizationUser[]
  invitations            Invitation[]
  roles                  Role[]
  devices                Device[]
  auditLogs              AuditLog[]
  idempotencyRecords     IdempotencyRecord[]
  categories             Category[]
  brands                 Brand[]
  units                  Unit[]
  products               Product[]
  productVariants        ProductVariant[]
  stockLocations         StockLocation[]
  stockMovements         StockMovement[]
  inventoryBalances      InventoryBalance[]
  stockTransfers         StockTransfer[]
  sales                  Sale[]
  saleItems              SaleItem[]
  payments               Payment[]
  invoiceSequences       InvoiceSequence[]
  suppliers              Supplier[]
  purchases              Purchase[]
  purchaseItems          PurchaseItem[]
  supplierPayments       SupplierPayment[]
  customers              Customer[]
  customerLedger         CustomerLedgerEntry[]
  customerPayments       CustomerPayment[]
  paymentAllocations     CustomerPaymentAllocation[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  serviceProfiles        ServiceProfile[]
  staffProfiles          StaffProfile[]
  staffServices          StaffService[]
  staffBranches          StaffBranch[]
  staffAvailability      StaffAvailability[]
  staffTimeOff           StaffTimeOff[]
  appointments           Appointment[]
  appointmentServices    AppointmentService[]
  commissionRules        CommissionRule[]
  commissions            Commission[]
  offlineTransactions    OfflineTransaction[]
  subscription           Subscription?
  subscriptionEvents     SubscriptionEvent[]
  billingRecords         BillingRecord[]
  billingSequences       BillingSequence[]
  paystackPayments       PaystackPaymentIntent[]
  pilot                  PilotOrganization?
  featureFlags           OrganizationFeatureFlag[]
  onboardingSteps        OrganizationOnboardingStep[]
  supportIssues          SupportIssue[]
  pilotFeedback          PilotFeedback[]
  cashierReconciliations CashierReconciliation[]
  refunds                SaleRefund[]
  registerShifts         RegisterShift[]
  operationalAlerts      OperationalAlert[]

  @@index([status])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  phone          String?
  email          String?
  address        String?
  timezone       String   @default("Asia/Qatar")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships            OrganizationUser[]
  invitations            Invitation[]
  devices                Device[]
  stockLocations         StockLocation[]
  stockMovements         StockMovement[]
  inventoryBalances      InventoryBalance[]
  transfersFrom          StockTransfer[]         @relation("TransferFromBranch")
  transfersTo            StockTransfer[]         @relation("TransferToBranch")
  sales                  Sale[]
  purchases              Purchase[]
  expenses               Expense[]
  staffBranches          StaffBranch[]
  staffAvailability      StaffAvailability[]
  appointments           Appointment[]
  commissions            Commission[]
  paystackPayments       PaystackPaymentIntent[]
  supportIssues          SupportIssue[]
  cashierReconciliations CashierReconciliation[]
  refunds                SaleRefund[]
  registerShifts         RegisterShift[]
  operationalAlerts      OperationalAlert[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("branches")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean    @default(false)
  isPlatformAdmin Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships               OrganizationUser[]
  invitations               Invitation[]                 @relation("InvitationUser")
  sentInvitations           Invitation[]                 @relation("InvitationInviter")
  accountTokens             AccountToken[]
  sessions                  AuthSession[]
  devices                   Device[]
  auditLogs                 AuditLog[]
  productsCreated           Product[]                    @relation("ProductCreator")
  movementsCreated          StockMovement[]              @relation("MovementCreator")
  transfersCreated          StockTransfer[]              @relation("TransferCreator")
  salesCreated              Sale[]                       @relation("SaleCreator")
  paymentsRecorded          Payment[]                    @relation("PaymentRecorder")
  suppliersCreated          Supplier[]                   @relation("SupplierCreator")
  purchasesCreated          Purchase[]                   @relation("PurchaseCreator")
  supplierPaymentsRecorded  SupplierPayment[]            @relation("SupplierPaymentRecorder")
  customersCreated          Customer[]                   @relation("CustomerCreator")
  customerLedgerEntries     CustomerLedgerEntry[]        @relation("CustomerLedgerCreator")
  customerPaymentsRecorded  CustomerPayment[]            @relation("CustomerPaymentRecorder")
  expensesCreated           Expense[]                    @relation("ExpenseCreator")
  staffProfiles             StaffProfile[]
  staffProfilesCreated      StaffProfile[]               @relation("StaffProfileCreator")
  staffTimeOffCreated       StaffTimeOff[]               @relation("StaffTimeOffCreator")
  appointmentsCreated       Appointment[]                @relation("AppointmentCreator")
  commissionRulesCreated    CommissionRule[]             @relation("CommissionRuleCreator")
  subscriptionEventsCreated SubscriptionEvent[]          @relation("SubscriptionEventCreator")
  billingRecordsConfirmed   BillingRecord[]              @relation("BillingRecordConfirmer")
  paystackPaymentsCreated   PaystackPaymentIntent[]
  cashierReconciliations    CashierReconciliation[]      @relation("CashierReconciliationCashier")
  reconciliationsSubmitted  CashierReconciliation[]      @relation("CashierReconciliationSubmitter")
  reconciliationsApproved   CashierReconciliation[]      @relation("CashierReconciliationApprover")
  pilotsOwned               PilotOrganization[]          @relation("PilotSupportOwner")
  onboardingStepsCompleted  OrganizationOnboardingStep[] @relation("OnboardingCompletedBy")
  supportIssuesReported     SupportIssue[]               @relation("SupportIssueReporter")
  pilotFeedbackSubmitted    PilotFeedback[]              @relation("PilotFeedbackSubmitter")
  refundsCreated            SaleRefund[]                 @relation("RefundCreator")
  shiftsOpened              RegisterShift[]              @relation("ShiftOpener")
  shiftsCashier             RegisterShift[]              @relation("ShiftCashier")
  shiftsClosed              RegisterShift[]              @relation("ShiftCloser")
  shiftsApproved            RegisterShift[]              @relation("ShiftApprover")
  cashMovementsCreated      CashMovement[]
  alertsAcknowledged        OperationalAlert[]           @relation("AlertAcknowledger")

  @@index([status])
  @@map("users")
}

model AccountToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt])
  @@index([expiresAt])
  @@map("account_tokens")
}

model PilotOrganization {
  id                   String      @id @default(uuid()) @db.Uuid
  organizationId       String      @unique @db.Uuid
  status               PilotStatus @default(PENDING_SETUP)
  pilotStartedAt       DateTime?
  pilotEndedAt         DateTime?
  assignedSupportOwner String?     @db.Uuid
  businessCategory     String?
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supportOwner User?        @relation("PilotSupportOwner", fields: [assignedSupportOwner], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@map("pilot_organizations")
}

model OrganizationFeatureFlag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  featureCode    String
  enabled        Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureCode])
  @@index([featureCode, enabled])
  @@map("organization_feature_flags")
}

model OrganizationOnboardingStep {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  stepCode       String
  status         OnboardingStepStatus @default(PENDING)
  completedAt    DateTime?
  completedBy    String?              @db.Uuid
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  completer    User?        @relation("OnboardingCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, stepCode])
  @@index([organizationId, status])
  @@map("organization_onboarding_steps")
}

model SupportIssue {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  reportedBy     String               @db.Uuid
  category       SupportIssueCategory
  severity       SupportIssueSeverity @default(MEDIUM)
  title          String
  description    String
  status         SupportIssueStatus   @default(OPEN)
  requestId      String?
  invoiceNumber  String?
  localReference String?
  appVersion     String?
  branchId       String?              @db.Uuid
  deviceId       String?              @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporter     User         @relation("SupportIssueReporter", fields: [reportedBy], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, severity, createdAt])
  @@map("support_issues")
}

model PilotFeedback {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  submittedBy    String           @db.Uuid
  category       FeedbackCategory
  title          String
  description    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submitter    User         @relation("PilotFeedbackSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("pilot_feedback")
}

model OrganizationUser {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  roleId         String           @db.Uuid
  branchId       String?          @db.Uuid
  employeeNumber String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId, branchId, status])
  @@map("organization_users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  name           String
  code           String
  isSystemRole   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  OrganizationUser[]
  invitations  Invitation[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  lastSeenAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Invitation {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  userId          String    @db.Uuid
  invitedByUserId String    @db.Uuid
  roleId          String    @db.Uuid
  branchId        String?   @db.Uuid
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId])
  @@index([expiresAt, acceptedAt, revokedAt])
  @@map("invitations")
}

model Device {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @db.Uuid
  branchId              String?             @db.Uuid
  userId                String?             @db.Uuid
  name                  String
  deviceUuid            String              @unique
  status                DeviceStatus        @default(ACTIVE)
  lastSeenAt            DateTime?
  lastSyncAt            DateTime?
  revokedAt             DateTime?
  entitlementSnapshotAt DateTime?
  entitlementExpiresAt  DateTime?
  offlineEntitled       Boolean             @default(false)
  entitlementStatus     SubscriptionStatus?
  createdAt             DateTime            @default(now())
  supportIssues         SupportIssue[]
  updatedAt             DateTime            @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  sales               Sale[]
  offlineTransactions OfflineTransaction[]
  registerShifts      RegisterShift[]

  @@index([organizationId, branchId, status])
  @@index([organizationId, userId, status])
  @@map("devices")
}

model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  description       String?
  monthlyPriceMinor Int
  annualPriceMinor  Int
  currency          String   @default("QAR")
  isPublic          Boolean  @default(true)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  features               PlanFeature[]
  limits                 PlanLimit[]
  subscriptions          Subscription[]      @relation("SubscriptionPlan")
  pendingSubscriptions   Subscription[]      @relation("PendingSubscriptionPlan")
  subscriptionEventsFrom SubscriptionEvent[] @relation("SubscriptionEventFromPlan")
  subscriptionEventsTo   SubscriptionEvent[] @relation("SubscriptionEventToPlan")
  billingRecords         BillingRecord[]

  @@index([isActive, isPublic, sortOrder])
  @@map("plans")
}

model PlanFeature {
  id          String  @id @default(uuid()) @db.Uuid
  planId      String  @db.Uuid
  featureCode String
  enabled     Boolean @default(true)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode])
  @@index([featureCode, enabled])
  @@map("plan_features")
}

model PlanLimit {
  id        String @id @default(uuid()) @db.Uuid
  planId    String @db.Uuid
  limitCode String
  value     Int?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, limitCode])
  @@index([limitCode])
  @@map("plan_limits")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @db.Uuid
  planId             String             @db.Uuid
  pendingPlanId      String?            @db.Uuid
  status             SubscriptionStatus
  billingInterval    BillingInterval    @default(MONTHLY)
  currency           String             @default("QAR")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  activatedAt        DateTime?
  suspendedAt        DateTime?
  changeEffectiveAt  DateTime?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan                @relation("SubscriptionPlan", fields: [planId], references: [id], onDelete: Restrict)
  pendingPlan    Plan?               @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  events         SubscriptionEvent[]
  billingRecords BillingRecord[]

  @@index([status, currentPeriodEnd])
  @@index([planId, status])
  @@index([trialEndsAt])
  @@index([graceEndsAt])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  subscriptionId String              @db.Uuid
  eventType      String
  fromPlanId     String?             @db.Uuid
  toPlanId       String?             @db.Uuid
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus?
  metadata       Json?
  occurredAt     DateTime            @default(now())
  createdBy      String?             @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromPlan     Plan?        @relation("SubscriptionEventFromPlan", fields: [fromPlanId], references: [id], onDelete: SetNull)
  toPlan       Plan?        @relation("SubscriptionEventToPlan", fields: [toPlanId], references: [id], onDelete: SetNull)
  creator      User?        @relation("SubscriptionEventCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([subscriptionId, eventType, occurredAt])
  @@map("subscription_events")
}

model BillingSequence {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  year           Int
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year])
  @@map("billing_sequences")
}

model BillingRecord {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  subscriptionId   String              @db.Uuid
  planId           String              @db.Uuid
  billingNumber    String              @unique
  planCodeSnapshot String
  planNameSnapshot String
  billingInterval  BillingInterval
  periodStart      DateTime
  periodEnd        DateTime
  amountMinor      Int
  currency         String
  status           BillingRecordStatus @default(DUE)
  paymentMethod    String?
  paymentReference String?
  confirmationKey  String?             @unique
  dueAt            DateTime?
  paidAt           DateTime?
  confirmedBy      String?             @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription    Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan            Plan                   @relation(fields: [planId], references: [id], onDelete: Restrict)
  confirmer       User?                  @relation("BillingRecordConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)
  paystackPayment PaystackPaymentIntent?

  @@index([organizationId, status, createdAt])
  @@index([subscriptionId, status, dueAt])
