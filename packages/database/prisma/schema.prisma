  normalizedName String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  taxNumber      String?
  notes          String?
  isActive       Boolean  @default(true)
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User              @relation("SupplierCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  purchases    Purchase[]
  payments     SupplierPayment[]

  @@index([organizationId, normalizedName])
  @@index([organizationId, isActive])
  @@map("suppliers")
}

model Purchase {
  id                    String         @id @default(uuid()) @db.Uuid
  organizationId        String         @db.Uuid
  branchId              String         @db.Uuid
  supplierId            String         @db.Uuid
  purchaseNumber        String
  supplierInvoiceNumber String?
  status                PurchaseStatus @default(DRAFT)
  subtotalMinor         Int
  discountMinor         Int            @default(0)
  taxMinor              Int            @default(0)
  totalMinor            Int
  paidMinor             Int            @default(0)
  balanceMinor          Int
  currency              String         @default("QAR")
  purchaseDate          DateTime
  expectedDate          DateTime?
  receivedAt            DateTime?
  cancelledAt           DateTime?
  notes                 String?
  createdBy             String         @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier     Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator      User              @relation("PurchaseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  items        PurchaseItem[]
  payments     SupplierPayment[]

  @@unique([organizationId, purchaseNumber])
  @@index([organizationId, branchId, purchaseDate])
  @@index([organizationId, supplierId, purchaseDate])
  @@index([organizationId, status, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @db.Uuid
  purchaseId          String   @db.Uuid
  productId           String   @db.Uuid
  variantId           String?  @db.Uuid
  productNameSnapshot String
  variantNameSnapshot String?
  skuSnapshot         String?
  orderedQuantity     Decimal  @db.Decimal(18, 4)
  receivedQuantity    Decimal  @default(0) @db.Decimal(18, 4)
  unitCostMinor       Int
  discountMinor       Int      @default(0)
  taxMinor            Int      @default(0)
  totalMinor          Int
  createdAt           DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchase     Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([organizationId, productId, variantId])
  @@map("purchase_items")
}

model SupplierPayment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  supplierId     String        @db.Uuid
  purchaseId     String        @db.Uuid
  amountMinor    Int
  method         PaymentMethod
  reference      String?
  paidAt         DateTime      @default(now())
  notes          String?
  createdBy      String        @db.Uuid
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase     Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  creator      User         @relation("SupplierPaymentRecorder", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([organizationId, supplierId, paidAt])
  @@index([purchaseId, paidAt])
  @@map("supplier_payments")
}

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  name             String
  phone            String?
  email            String?
  language         String?
  creditLimitMinor Int?
  balanceMinor     Int      @default(0)
  notes            String?
  isActive         Boolean  @default(true)
  createdBy        String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User                  @relation("CustomerCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  sales        Sale[]
  ledger       CustomerLedgerEntry[]
  payments     CustomerPayment[]
  appointments Appointment[]

  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, isActive])
  @@map("customers")
}

model CustomerLedgerEntry {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  customerId        String                  @db.Uuid
  entryType         CustomerLedgerEntryType
  referenceType     String
  referenceId       String
  debitMinor        Int                     @default(0)
  creditMinor       Int                     @default(0)
  balanceAfterMinor Int
  description       String?
  occurredAt        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  createdBy         String                  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator      User         @relation("CustomerLedgerCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, entryType, referenceType, referenceId])
  @@index([organizationId, customerId, occurredAt])
  @@index([organizationId, referenceType, referenceId])
  @@map("customer_ledger_entries")
}

model CustomerPayment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  customerId     String        @db.Uuid
  amountMinor    Int
  method         PaymentMethod
  reference      String?
  paidAt         DateTime      @default(now())
  notes          String?
  createdBy      String        @db.Uuid
  createdAt      DateTime      @default(now())

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator      User                        @relation("CustomerPaymentRecorder", fields: [createdBy], references: [id], onDelete: Restrict)
  allocations  CustomerPaymentAllocation[]

  @@index([organizationId, customerId, paidAt])
  @@map("customer_payments")
}

model CustomerPaymentAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  customerPaymentId String   @db.Uuid
  saleId            String   @db.Uuid
  amountMinor       Int
  createdAt         DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerPayment CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)
  sale            Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([customerPaymentId, saleId])
  @@index([organizationId, saleId])
  @@map("customer_payment_allocations")
}

model ExpenseCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  normalizedName String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, isActive])
  @@map("expense_categories")
}

model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String        @db.Uuid
  categoryId     String        @db.Uuid
  amountMinor    Int
  currency       String        @default("QAR")
  paymentMethod  PaymentMethod
  expenseDate    DateTime
  description    String?
  reference      String?
  attachmentUrl  String?
  status         ExpenseStatus @default(RECORDED)
  createdBy      String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator      User            @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([organizationId, branchId, expenseDate])
  @@index([organizationId, categoryId, expenseDate])
  @@index([organizationId, paymentMethod, expenseDate])
  @@map("expenses")
}

model ServiceProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @db.Uuid
  productId           String   @unique @db.Uuid
  durationMinutes     Int
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(0)
  appointmentEnabled  Boolean  @default(true)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, appointmentEnabled, isActive])
  @@map("service_profiles")
}

model StaffProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  displayName    String
  phone          String?
  email          String?
  employeeNumber String?
  jobTitle       String?
  isBookable     Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  creator             User                 @relation("StaffProfileCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  services            StaffService[]
  branches            StaffBranch[]
  availability        StaffAvailability[]
  timeOff             StaffTimeOff[]
  primaryAppointments Appointment[]        @relation("AppointmentPrimaryStaff")
  appointmentServices AppointmentService[]
  saleItems           SaleItem[]
  commissionRules     CommissionRule[]
  commissions         Commission[]

  @@unique([organizationId, userId])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId, isActive, displayName])
  @@map("staff_profiles")
}

model StaffService {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @db.Uuid
  staffProfileId        String   @db.Uuid
  serviceProductId      String   @db.Uuid
  customDurationMinutes Int?
  customPriceMinor      Int?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  serviceProduct Product      @relation(fields: [serviceProductId], references: [id], onDelete: Restrict)

  @@unique([staffProfileId, serviceProductId])
  @@index([organizationId, serviceProductId, isActive])
  @@map("staff_services")
}

model StaffBranch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  staffProfileId String   @db.Uuid
  branchId       String   @db.Uuid
  isPrimary      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([staffProfileId, branchId])
  @@index([organizationId, branchId, isActive])
  @@map("staff_branches")
}

model StaffAvailability {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  staffProfileId String   @db.Uuid
  branchId       String   @db.Uuid
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([organizationId, staffProfileId, branchId, dayOfWeek, isActive])
  @@map("staff_availability")
}

model StaffTimeOff {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  staffProfileId String   @db.Uuid
  startAt        DateTime
  endAt          DateTime
  reason         String?
  createdBy      String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  creator      User         @relation("StaffTimeOffCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([organizationId, staffProfileId, startAt, endAt])
  @@map("staff_time_off")
}

model Appointment {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @db.Uuid
  branchId              String            @db.Uuid
  customerId            String?           @db.Uuid
  customerNameSnapshot  String?
  customerPhoneSnapshot String?
  primaryStaffProfileId String            @db.Uuid
  status                AppointmentStatus @default(BOOKED)
  startAt               DateTime
  endAt                 DateTime
  blockedStartAt        DateTime
  blockedEndAt          DateTime
  notes                 String?
  cancellationReason    String?
  saleId                String?           @unique @db.Uuid
  createdBy             String            @db.Uuid
  confirmedAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  noShowAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  primaryStaff StaffProfile         @relation("AppointmentPrimaryStaff", fields: [primaryStaffProfileId], references: [id], onDelete: Restrict)
  sale         Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  creator      User                 @relation("AppointmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  services     AppointmentService[]
  commissions  Commission[]

  @@index([organizationId, branchId, startAt, endAt])
  @@index([organizationId, primaryStaffProfileId, status, startAt])
  @@index([organizationId, customerId, startAt])
  @@map("appointments")
}

model AppointmentService {
  id                      String   @id @default(uuid()) @db.Uuid
  organizationId          String   @db.Uuid
  appointmentId           String   @db.Uuid
  serviceProductId        String   @db.Uuid
  staffProfileId          String   @db.Uuid
  serviceNameSnapshot     String
  durationMinutesSnapshot Int
  priceMinorSnapshot      Int
  sequence                Int
  startAt                 DateTime
  endAt                   DateTime
  blockedStartAt          DateTime
  blockedEndAt            DateTime
  createdAt               DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceProduct Product      @relation(fields: [serviceProductId], references: [id], onDelete: Restrict)
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, sequence])
  @@index([appointmentId, staffProfileId, serviceProductId])
  @@map("appointment_services")
}

model CommissionRule {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  staffProfileId   String             @db.Uuid
  serviceProductId String?            @db.Uuid
  type             CommissionRuleType
  basisPoints      Int?
  valueMinor       Int?
  priority         Int                @default(0)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  isActive         Boolean            @default(true)
  createdBy        String             @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  serviceProduct Product?     @relation(fields: [serviceProductId], references: [id], onDelete: Restrict)
  creator        User         @relation("CommissionRuleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  commissions    Commission[]

  @@index([organizationId, staffProfileId, serviceProductId, isActive])
  @@map("commission_rules")
}

model Commission {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  branchId              String           @db.Uuid
  staffProfileId        String           @db.Uuid
  saleId                String           @db.Uuid
  saleItemId            String           @db.Uuid
  appointmentId         String?          @db.Uuid
  ruleId                String?          @db.Uuid
  baseAmountMinor       Int
  commissionAmountMinor Int
  status                CommissionStatus @default(EARNED)
  earnedAt              DateTime         @default(now())
  createdAt             DateTime         @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staffProfile StaffProfile    @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  sale         Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleItem     SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  appointment  Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  rule         CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([saleItemId, staffProfileId])
  @@index([organizationId, staffProfileId, earnedAt])
  @@index([organizationId, branchId, earnedAt])
  @@index([organizationId, saleId])
  @@map("commissions")
}
