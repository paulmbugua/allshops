# Copy to ops/vps-production.env on the VPS and chmod 600. Never commit it.
APP_DOMAIN=allshops.ekazi.co.ke
API_DOMAIN=api.ekazi.co.ke
APP_URL=https://allshops.ekazi.co.ke
API_URL=https://api.ekazi.co.ke
CORS_ORIGINS=https://allshops.ekazi.co.ke
ACME_EMAIL=admin@ekazi.co.ke

POSTGRES_DB=allshops
POSTGRES_USER=allshops
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
DATABASE_URL=postgresql://allshops:REPLACE_WITH_SAME_URL_SAFE_RANDOM_PASSWORD@postgres:5432/allshops?schema=public
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_SAME_URL_SAFE_RANDOM_PASSWORD@redis:6379

JWT_ACCESS_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="AllShops <no-reply@your-domain.example>"

PAYSTACK_SECRET_KEY=sk_live_REPLACE_ME
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SUBSCRIPTION_CALLBACK_URL=https://allshops.ekazi.co.ke/settings/subscription/payment-return
PAYSTACK_CURRENCY=KES
PAYSTACK_QAR_TO_KES_RATE=

REGISTRY=ghcr.io/paulmbugua
IMAGE_TAG=sha-REPLACE_WITH_GIT_SHA
APP_VERSION=1.0.0
GIT_SHA=REPLACE_WITH_GIT_SHA
BUILD_TIME=REPLACE_WITH_UTC_TIMESTAMP
LOG_LEVEL=info
SENTRY_DSN=
METRICS_ENABLED=false
METRICS_TOKEN=
