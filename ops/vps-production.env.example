# Copy to ops/vps-production.env on the VPS and chmod 600. Never commit it.
APP_DOMAIN=allshopspos.com
WWW_DOMAIN=www.allshopspos.com
API_DOMAIN=api.allshopspos.com
APP_URL=https://allshopspos.com
API_URL=https://api.allshopspos.com
NEXT_PUBLIC_API_URL=https://api.allshopspos.com/api/v1
CORS_ORIGINS=https://allshopspos.com,https://www.allshopspos.com
ACME_EMAIL=admin@allshopspos.com

# Token for a dedicated, remotely managed Cloudflare Tunnel. Configure its
# public hostnames to use http://allshops-web:3000 and http://allshops-api:4000.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN

# Generated once by /opt/infrastructure/postgres/bin/create-app-db.sh allshops.
# Application traffic uses PgBouncer; schema migrations use PostgreSQL directly.
DATABASE_URL=postgresql://allshops_user:REPLACE_WITH_APP_DB_PASSWORD@shared-pgbouncer:6432/allshops_db?schema=public&pgbouncer=true&connection_limit=4
DIRECT_DATABASE_URL=postgresql://allshops_user:REPLACE_WITH_APP_DB_PASSWORD@shared-postgres:5432/allshops_db?schema=public&connection_limit=2
REDIS_URL=redis://:REPLACE_WITH_SHARED_REDIS_PASSWORD@shared-redis:6379/0
REDIS_KEY_PREFIX=allshops:

JWT_ACCESS_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="AllShops <no-reply@your-domain.example>"
MAIL_REPLY_TO=no-reply@your-domain.example

PAYSTACK_SECRET_KEY=sk_live_REPLACE_ME
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SUBSCRIPTION_CALLBACK_URL=https://allshopspos.com/settings/subscription/payment-return
PAYSTACK_CURRENCY=KES
PAYSTACK_QAR_TO_KES_RATE=

REGISTRY=ghcr.io/paulmbugua
IMAGE_TAG=sha-REPLACE_WITH_GIT_SHA
APP_VERSION=1.0.0
GIT_SHA=REPLACE_WITH_GIT_SHA
BUILD_TIME=REPLACE_WITH_UTC_TIMESTAMP
LOG_LEVEL=info
SENTRY_DSN=
METRICS_ENABLED=false
METRICS_TOKEN=
