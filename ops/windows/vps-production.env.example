NODE_ENV=production
DATABASE_URL=postgresql://allshops:REPLACE_WITH_URL_SAFE_PASSWORD@127.0.0.1:5432/allshops?schema=public
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:6379

APP_URL=https://allshops.ekazi.co.ke
API_URL=https://api.ekazi.co.ke
CORS_ORIGINS=https://allshops.ekazi.co.ke
TRUST_PROXY=loopback
PRODUCT_IMAGE_DIRECTORY=C:\AllShops\data\product-images
PRODUCT_IMAGE_MAX_BYTES=5242880
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Staff invitation email. Use your provider's SMTP credentials.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="AllShops <no-reply@your-domain.example>"

PAYSTACK_SECRET_KEY=sk_live_REPLACE_ME
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SUBSCRIPTION_CALLBACK_URL=https://allshops.ekazi.co.ke/settings/subscription/payment-return
PAYSTACK_CURRENCY=KES
PAYSTACK_QAR_TO_KES_RATE=

NEXT_PUBLIC_API_URL=/api/v1
APP_VERSION=1.0.0
GIT_SHA=unknown
BUILD_TIME=unknown
LOG_LEVEL=info
SWAGGER_ENABLED=false
METRICS_ENABLED=false
SENTRY_DSN=
