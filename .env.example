# Runtime
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
TRUST_INCOMING_REQUEST_ID=false
APP_VERSION=0.0.0
GIT_SHA=development
BUILD_TIME=development

# Infrastructure (development values only; use secret storage in production)
DATABASE_URL=postgresql://allshops:allshops@localhost:5433/allshops?schema=public
REDIS_URL=redis://localhost:6379

# Authentication — replace with independent 32+ character random values in production
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
INVITATION_TTL_HOURS=48

# Request security and resilience
JSON_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5
REFRESH_RATE_LIMIT_MAX=30
SYNC_RATE_LIMIT_MAX=60
EXPORT_RATE_LIMIT_MAX=10
BILLING_RATE_LIMIT_MAX=20
MAINTENANCE_MODE=false
SWAGGER_ENABLED=false

# Reporting and offline POS
REPORT_EXPORT_MAX_ROWS=50000
REPORT_CACHE_TTL_SECONDS=60
REPORT_MAX_RANGE_DAYS=366
OFFLINE_SESSION_MAX_HOURS=24
OFFLINE_PRICE_MAX_AGE_HOURS=72
OFFLINE_CLOCK_SKEW_HOURS=24
SYNC_BATCH_SIZE=50

# SaaS subscriptions and worker
TRIAL_DAYS=30
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_JOB_INTERVAL_MINUTES=60
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=4001

# Optional subscription-only Paystack checkout (secret is API-only)
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SUBSCRIPTION_CALLBACK_URL=http://localhost:3000/settings/subscription/payment-return
PAYSTACK_CURRENCY=KES
# Required only when the Paystack currency differs from the QAR subscription ledger.
PAYSTACK_QAR_TO_KES_RATE=

# Observability — metrics stay disabled unless a strong token is set
LOG_LEVEL=info
SLOW_QUERY_THRESHOLD_MS=1000
SENTRY_DSN=
METRICS_ENABLED=false
METRICS_TOKEN=

# Production Compose/release
REGISTRY=ghcr.io/paulmbugua
IMAGE_TAG=sha-replace-me
PROXY_PORT=8080
